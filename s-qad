/orders:
  get:
    description: Retrieve order integration records, optionally filtered by specific sales orders.
    queryParameters:
      orders?:
        displayName: Orders
        description: Optional list of sales order identifiers used to filter the results.
        type: string[]
        repeat: true
        example:
          - SO12345
          - SO67890
    responses:
      200:
        description: Order records retrieved successfully.
        body:
          application/json:
            type: orderQueryResponse
            example:
              orderRecords:
                - targetApp: QAD
                  domain: DOM1
                  orderStatus: Open
                  salesOrder: SO12345
                  exclDomainList: DOMA,DOMB
                  maxRows: 100
                - targetApp: QAD
                  domain: DOM2
                  orderStatus: Closed
                  salesOrder: SO67890
                  exclDomainList: DOMC
                  maxRows: 50
  patch:
    description: Update an existing order integration record.
    body:
      application/json:
        type: orderRecord
        example:
          targetApp: QAD
          domain: DOM1
          orderStatus: InProgress
          salesOrder: SO12345
          exclDomainList: DOMA,DOMB
          maxRows: 1
    responses:
      200:
        description: Order record updated successfully.
        body:
          application/json:
            type: orderUpdateResponse
            example:
              orderUpdate:
                updateStatus: Record updated successfully
/productLines:
  post:
    description: Fetch product lines
    body:
      application/json:
        type: productLineQueryRequest
        example:
          queryRequests:
            - sourceApplication: QAD
              profile: default
              filter: domain eq "PL"
              maxRows: 100
              ignoreBoFilter: false
              ignoreBoInnerJoin: true
    responses:
      200:
        description: Product line metadata retrieved successfully.
        body:
          application/json:
            type: productLineQueryResponse
            example:
              codeMasters:
                - codeCmmt: Product line comment
                  codeDesc: Electronics
                  codeDomain: PL
                  codeFldname: productLine
                  codeValue: ELEC
/customers:
  post:
    description: Fetch customer data
    body:
      application/json:
        type: customerQueryRequest
        example:
          queryRequests:
            - sourceApplication: QAD
              profile: customerDefault
              filter: domain eq "CUST"
              maxRows: 50
              ignoreBoFilter: false
              ignoreBoInnerJoin: false
    responses:
      200:
        description: Customer data retrieved successfully.
        body:
          application/json:
            type: customerQueryResponse
            example:
              customers:
                - cmAddr: CUST001
                  cmDomain: DOM1
                  cmActive: true
                  cmChannel: Direct
                  cmClass: A
                  addresses:
                    - adAddr: CUST001
                      adCity: New York
                      adCountry: USA
                      addressLines:
                        - addressId: 101
                          addressName: Headquarters
                          contacts:
                            - contactId: 1001
                              contactName: John Doe
                              contactEmail: john.doe@example.com
                  codeMasters:
                    - codeDomain: CM
                      codeFldname: customerType
                      codeValue: Wholesale
                  debtors:
                    - debtorId: 5001
                      debtorCode: D-CUST001
                      debtorFixedCredLimtC: 100000.00
                  internalRepresentatives:
                    - irlAddr: CUST001
                      irlEmp: EMP100
                      irlType: AccountManager

