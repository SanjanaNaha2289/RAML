#%RAML 1.0
title: s-qad Orders API
version: v1
baseUri: https://api.example.com/s-qad
protocols: [ HTTPS ]
mediaType: application/json

types:
  orderQueryResponse:
    description: Collection of order integration records converted from the legacy XML schema.
    type: object
    properties:
      orderRecords?:
        description: Optional collection of order integration rows.
        type: orderRecord[]
  orderRecord:
    description: Order integration record derived from the TtOrderIntInputType definition.
    type: object
    properties:
      targetApp?:
        type: string
        description: Target application identifier.
      domain?:
        type: string
        description: Business domain code.
      orderStatus?:
        type: string
        description: Current status of the sales order.
      salesOrder?:
        type: string
        description: Sales order identifier.
      exclDomainList?:
        type: string
        description: Comma-delimited list of domains to exclude.
      maxRows?:
        type: integer
        description: Maximum number of rows to return.
  orderUpdateResponse:
    description: Result of updating an order integration record.
    type: object
    properties:
      orderUpdate:
        type: object
        properties:
          updateStatus:
            type: string
            description: Outcome of the update operation.

/orders:
  get:
    description: Retrieve order integration records, optionally filtered by specific sales orders.
    queryParameters:
      orders?:
        displayName: Orders
        description: Optional list of sales order identifiers used to filter the results.
        type: string[]
        repeat: true
        example:
          - SO12345
          - SO67890
    responses:
      200:
        description: Order records retrieved successfully.
        body:
          application/json:
            type: orderQueryResponse
            example:
              orderRecords:
                - targetApp: QAD
                  domain: DOM1
                  orderStatus: Open
                  salesOrder: SO12345
                  exclDomainList: DOMA,DOMB
                  maxRows: 100
                - targetApp: QAD
                  domain: DOM2
                  orderStatus: Closed
                  salesOrder: SO67890
                  exclDomainList: DOMC
                  maxRows: 50
  patch:
    description: Update an existing order integration record.
    body:
      application/json:
        type: orderRecord
        example:
          targetApp: QAD
          domain: DOM1
          orderStatus: InProgress
          salesOrder: SO12345
          exclDomainList: DOMA,DOMB
          maxRows: 1
    responses:
      200:
        description: Order record updated successfully.
        body:
          application/json:
            type: orderUpdateResponse
            example:
              orderUpdate:
                updateStatus: Record updated successfully

